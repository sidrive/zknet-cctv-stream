# Port HTTP aplikasi
PORT=8080

# Lokasi database konfigurasi (SQLite). Hanya konfigurasi kamera/cluster/admin, TIDAK ada video.
DATA_DIR=./data

# Secret penanda tangan sesi admin & token akses. Jika kosong dibuat otomatis lalu disimpan di database.
# Isi nilai acak panjang jika menjalankan lebih dari satu instance.
JWT_SECRET=

# Opsional: jika diisi, pembuatan admin pertama (/admin) wajib menyertakan token ini.
# Sangat disarankan saat aplikasi dipasang di internet sebelum admin dibuat.
SETUP_TOKEN=

# Wajib "true" bila diakses lewat HTTPS agar cookie admin hanya terkirim via HTTPS.
COOKIE_SECURE=false
# "true" bila berada di belakang reverse proxy (nginx/ALB/Cloudflare) agar IP klien & rate limit benar.
TRUST_PROXY=false

# ffmpeg untuk sumber RTSP/RTMP/SRT -> HLS
FFMPEG_PATH=ffmpeg
# ffmpeg dimatikan otomatis setelah sekian detik tanpa penonton
FFMPEG_IDLE_SECONDS=30

# --- Khusus STB / SD card / eMMC ---
# Segmen HLS ffmpeg ditulis terus-menerus; taruh di RAM agar flash tidak cepat aus:
#   STREAM_TMP_DIR=/dev/shm/zknet-cctv
# Lokasi database di STB (di luar folder repo supaya aman dari git pull):
#   DATA_DIR=/var/lib/zknet-cctv
